# ==============================================================================
# MTG Limited IQ - Supabase Environment Configuration
# ==============================================================================
# 1. Create a free Supabase project at: https://supabase.com
# 2. Go to: Project Settings -> API
# 3. Copy your Project URL and anon public key into a local '.env' file:
#
# cp .env.example .env
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google OAuth & Google Identity Services (GSI) Web Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional: Set in production (Cloudflare Pages / Workers)
# VITE_APP_URL=https://your-domain.com

